				"source": [
					"Cell 1: read the 4 files "
				]
			},
			{
				"cell_type": "code",
				"source": [
					"src = \"abfss://nyctaxi@adlscustomer360anupa.dfs.core.windows.net/yellow_tripdata_2025-*.parquet\"\n",
					"df = spark.read.parquet(src)\n",
					"print(df.count())\n",
					"df.printSchema()"
				],
				"execution_count": 1
			},
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql.functions import year, month, col\n",
					"\n",
					"df2 = (df.withColumn(\"tpep_pickup_datetime\",  col(\"tpep_pickup_datetime\").cast(\"timestamp\"))\n",
					"         .withColumn(\"tpep_dropoff_datetime\", col(\"tpep_dropoff_datetime\").cast(\"timestamp\"))\n",
					"         .withColumn(\"year\",  year(col(\"tpep_pickup_datetime\")))\n",
					"         .withColumn(\"month\", month(col(\"tpep_pickup_datetime\")))\n",
					"         .filter((col(\"year\") == 2025) & (col(\"month\").between(1, 4))))\n",
					"\n",
					"dst = \"abfss://nyctaxi@adlscustomer360anupa.dfs.core.windows.net/delta/yellow_tripdata\"\n",
					"(df2.write.format(\"delta\")\n",
					"     .mode(\"overwrite\")\n",
					"     .partitionBy(\"year\", \"month\")\n",
					"     .save(dst))\n",
					"display(dst)"
				],
				"execution_count": 4
			},
			{
				"cell_type": "code",
				"source": [
					"spark.read.format(\"delta\").load(dst).groupBy(\"year\",\"month\").count().orderBy(\"month\").show()"
				],
				"execution_count": 5
			}
		]
	}
